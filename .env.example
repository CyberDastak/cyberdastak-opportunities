# =================================================================
# CyberDastak Opportunities - Local Environment Configuration
# Copy this file to .env for local testing (Do NOT commit .env)
# In GitHub, add these as Repository Secrets under Settings -> Secrets and variables -> Actions
# =================================================================

# 1. Adzuna API (India Jobs)
# Register for free at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# 2. JSearch API (RapidAPI / OpenWeb Ninja)
# Register for free at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# or https://openwebninja.com/api/jsearch
JSEARCH_API_KEY=your_rapidapi_jsearch_key

# 3. SMTP Email Configuration (Daily 9:00 AM IST Digest)
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
RECIPIENT_EMAIL=recipient_email@example.com

# 4. Optional Configurations
# Set to true to skip sending an email if no new opportunities were discovered in the morning run
SKIP_EMPTY_EMAIL=false

# Override deployed site URL for email button links (defaults to GitHub Pages URL)
SITE_URL=https://your-username.github.io/cyberdastak-opportunities
